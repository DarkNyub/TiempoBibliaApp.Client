
@using TiempoBiblia.Client.Models
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="">
    @if (pedidos == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <MudTable Items="@pedidos" Dense="true" Hover="true" Filter="new Func<PedidoAdminDto,bool>(FiltrarPedidos)" Elevation="0" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
            <ToolBarContent>
            <MudText Typo="Typo.h6">Historial de Ventas</MudText>
            
            <!-- 🔥 NUEVO BOTÓN DE ACTUALIZAR -->
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="RefrescarTabla" title="Actualizar datos" Class="ml-4" />
            <MudSpacer />
            <MudButton Size="Size.Small"  Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirModalNuevoPedido">
                Cargar Pedido Manual
            </MudButton>
            <MudSpacer />
            <MudTextField @bind-Value="textoBusqueda" Immediate="true" Placeholder="Buscar correo o ID..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Class="mt-0" Margin="Margin.Dense" />
        </ToolBarContent>
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>Transacción</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Pasarela</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Fecha">@context.FechaCreacion.ToString("dd MMM yy")</MudTd>
                <MudTd DataLabel="Transacción">
                    <MudText Typo="Typo.caption" Style="font-family: monospace;">@context.TransaccionGatewayId</MudText>
                </MudTd>
                <MudTd DataLabel="Cliente"><strong>@context.CorreoCliente</strong></MudTd>
                <MudTd DataLabel="Pasarela">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Pasarela switch { "MercadoPago" => Color.Warning, "PayPal" => Color.Info, "Gratuito" => Color.Secondary, _ => Color.Default })" Variant="Variant.Outlined">@context.Pasarela</MudChip>
                </MudTd>
                <MudTd DataLabel="Total"><strong>$@context.TotalCobrado.ToString("N2") @context.Moneda</strong></MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Estado == "approved" ? Color.Success : Color.Warning)">@context.Estado</MudChip>
                </MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: right;">
                    <!-- Botón Acordeón -->
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Dark" OnClick="@(() => AlternarAcordeon(context.Id))" Class="mr-2">
                        @(filasExpandidas.Contains(context.Id) ? "Ocultar" : "Ver Detalles")
                    </MudButton>
                    <!-- Botón Reenviar Correo -->
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.MarkEmailRead" Color="Color.Warning" OnClick="() => AbrirModalReenviar(context.Id, context.CorreoCliente)" />
                </MudTd>
            </RowTemplate>
            
            <!-- 🔥 EL ACORDEÓN MÁGICO (Se dibuja debajo de la fila si está expandida) -->
            <ChildRowContent>
                @if (filasExpandidas.Contains(context.Id))
                {
                    <MudTr>
                        <td colspan="7">
                            <MudCard Elevation="0" Class="pa-4" Style="background-color: #fafafa; border-left: 4px solid #E91E63;">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Productos Comprados (@context.CantidadProductos):</MudText>
                                <ul style="list-style-type: square; margin-left: 20px;">
                                    @if (context.Detalles != null && context.Detalles.Any())
                                    {
                                        @foreach (var det in context.Detalles)
                                        {
                                            <li>
                                                <MudText Typo="Typo.body2">
                                                    @det.NombreProductoHistorico - <strong>$@det.PrecioUnitarioPagado.ToString("N2")</strong>
                                                </MudText>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption">No hay detalles (Pudo ser una prueba gratuita).</MudText>
                                    }
                                </ul>
                                @if (!string.IsNullOrEmpty(context.Franquicia))
                                {
                                    <MudText Typo="Typo.caption" Class="mt-3 d-block text-muted">
                                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Size="Size.Small" Class="mr-1" />
                                        Tarjeta: @context.Franquicia (**** @context.Ultimos4Digitos)
                                    </MudText>
                                }
                            </MudCard>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="Ventas por página:" />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

<!-- 🔥 MODAL PARA REENVIAR / CORREGIR CORREO -->
<MudDialog @bind-Visible="mostrarModalReenviar" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Reenviar Pedido</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">Puedes corregir el correo si el cliente se equivocó.</MudText>
        <MudTextField @bind-Value="correoEdicion" Label="Correo del Cliente" Variant="Variant.Outlined" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="() => mostrarModalReenviar = false">Cancelar</MudButton>
        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="EjecutarReenvio" Disabled="procesandoReenvio">Reenviar Links</MudButton>
    </DialogActions>
</MudDialog>

<!-- 🔥 MODAL PARA INGRESAR PEDIDO MANUAL -->
<MudDialog @bind-Visible="mostrarModalManual" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Crear Pedido Manual 🛠️</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="nuevoPedido.CorreoCliente" Label="Correo del Cliente" Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="nuevoPedido.TransaccionGatewayId" Label="ID de Transacción (Manual)" Variant="Variant.Outlined" Required="true" Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="nuevoPedido.Pasarela" Label="Pasarela" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("MercadoPago")">MercadoPago</MudSelectItem>
                    <MudSelectItem Value="@("PayPal")">PayPal</MudSelectItem>
                    <MudSelectItem Value="@("Gratuito")">Gratuito</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="nuevoPedido.TotalCobrado" Label="Total Cobrado" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="nuevoPedido.Moneda" Label="Moneda" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("COP")">COP</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="nuevoPedido.ProductosIds" Label="Productos Comprados" Variant="Variant.Outlined" Margin="Margin.Dense"
                           MultiSelectionTextFunc="@( _ => ObtenerNombresProductosSeleccionados(nuevoPedido.ProductosIds) )">
                    @if (productosDisponibles != null)
                    {
                        @foreach (var p in productosDisponibles.Where(x => x.Activo))
                        {
                            <MudSelectItem T="int" Value="@p.Id">@p.Nombre</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="() => mostrarModalManual = false">Cancelar</MudButton>
        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="EjecutarPedidoManual" Disabled="procesandoManual">Guardar Pedido</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PedidoAdminDto>? pedidos;
    private string textoBusqueda = "";
    private HashSet<int> filasExpandidas = new(); // Guarda los IDs de las filas abiertas
    private bool procesandoReenvio = false;

    private bool mostrarModalReenviar = false;
    private int pedidoReenviarId = 0;
    private string correoEdicion = "";

    private bool mostrarModalManual = false;
    private bool procesandoManual = false;
    private CrearPedidoManualDto nuevoPedido = new();
    private List<ProductoDto>? productosDisponibles;

    protected override async Task OnInitializedAsync()
    {
        await CargarPedidos();
        // Cargar los productos para el MultiSelect
        try { productosDisponibles = await Http.GetFromJsonAsync<List<ProductoDto>>("api/Productos/admin"); } 
        catch { productosDisponibles = new List<ProductoDto>(); }
    }

    private async Task CargarPedidos()
    {
        try
        {
            pedidos = await Http.GetFromJsonAsync<List<PedidoAdminDto>>("api/Pedidos/admin");
        }
        catch (Exception)
        {
            Snackbar.Add("Error al cargar el historial de ventas.", Severity.Error);
        }
    }

    private bool FiltrarPedidos(PedidoAdminDto p)
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda)) return true;
        if (p.CorreoCliente.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)) return true;
        if (p.TransaccionGatewayId.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private void AlternarAcordeon(int id)
    {
        if (filasExpandidas.Contains(id))
            filasExpandidas.Remove(id);
        else
            filasExpandidas.Add(id);
    }

    private void AbrirModalReenviar(int id, string correoActual)
    {
        pedidoReenviarId = id;
        correoEdicion = correoActual; // Precarga el correo original
        mostrarModalReenviar = true;
    }

    private async Task EjecutarReenvio()
    {
        if(string.IsNullOrWhiteSpace(correoEdicion) || !correoEdicion.Contains("@")) {
            Snackbar.Add("Ingresa un correo válido.", Severity.Warning); return;
        }

        procesandoReenvio = true;
        try
        {
            var req = new ReenviarCorreoRequestDto { NuevoCorreo = correoEdicion.Trim() };
            var response = await Http.PostAsJsonAsync($"api/Pedidos/{pedidoReenviarId}/reenviar-correo", req);
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Correo reenviado con éxito!", Severity.Success);
                mostrarModalReenviar = false;
                await CargarPedidos(); // Refrescamos para ver el nuevo correo en la tabla
            }
            else 
            {
                // 🔥 NUEVO: Desempaquetamos el error real del backend
                var errorInfo = await response.Content.ReadFromJsonAsync<RespuestaErrorApiDto>();
                
                // Si viene un detalle específico lo mostramos, si no, mostramos el mensaje corto
                string mensajeMostrar = !string.IsNullOrWhiteSpace(errorInfo?.Detalle) 
                                        ? errorInfo.Detalle 
                                        : (errorInfo?.Mensaje ?? "Error desconocido al reenviar.");
                
                Snackbar.Add(mensajeMostrar, Severity.Error);
            }
        }
        catch 
        { 
            Snackbar.Add("Fallo de conexión con el servidor.", Severity.Error); 
        }
        finally 
        { 
            procesandoReenvio = false; 
        }
    }
    // 🔥 NUEVA FUNCIÓN PARA REFRESCAR
    private async Task RefrescarTabla()
    {
        pedidos = null; // Dispara la animación de carga visualmente
        StateHasChanged(); // Obliga al frontend a redibujarse
        
        await CargarPedidos(); // Trae los datos frescos de la BD
        
        Snackbar.Add("Historial actualizado", Severity.Success);
    }
    private void AbrirModalNuevoPedido()
{
    nuevoPedido = new CrearPedidoManualDto(); // Limpiamos el formulario
    mostrarModalManual = true;
}

private string ObtenerNombresProductosSeleccionados(IEnumerable<int> ids)
{
    if (productosDisponibles == null || !ids.Any()) return "Ninguno seleccionado";
    var nombres = productosDisponibles.Where(p => ids.Contains(p.Id)).Select(p => p.Nombre);
    return string.Join(", ", nombres);
}

private async Task EjecutarPedidoManual()
{
    if (string.IsNullOrWhiteSpace(nuevoPedido.CorreoCliente) || string.IsNullOrWhiteSpace(nuevoPedido.TransaccionGatewayId) || !nuevoPedido.ProductosIds.Any())
    {
        Snackbar.Add("Faltan datos obligatorios (Correo, ID o Productos).", Severity.Warning);
        return;
    }

    procesandoManual = true;
    try
    {
        var response = await Http.PostAsJsonAsync("api/Pedidos/manual", nuevoPedido);
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("¡Pedido manual registrado y correos enviados!", Severity.Success);
            mostrarModalManual = false;
            await CargarPedidos(); 
        }
        else 
        {
            var errorInfo = await response.Content.ReadFromJsonAsync<RespuestaErrorApiDto>();
            Snackbar.Add(errorInfo?.Mensaje ?? "Error al guardar.", Severity.Error);
        }
    }
    catch { Snackbar.Add("Error de conexión.", Severity.Error); }
    finally { procesandoManual = false; }
}
}