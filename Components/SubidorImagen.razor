@using System.Net.Http.Headers
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="pa-4 text-center" Style="border: 2px dashed #F48FB1; border-radius: 12px; background-color: #FFF0F5;">
    
    @if (string.IsNullOrEmpty(_imagenSeleccionada))
    {
        <!-- FASE 1: SELECCIONAR IMAGEN -->
        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Style="color: #E91E63;" Class="mb-2" />
        <MudText Typo="Typo.body1" Style="color: #5D4037; font-weight: bold;" Class="mb-4">Sube una imagen para recortar</MudText>
        
        <!-- 🔥 FIX MUD-BLAZOR: Truco maestro. Un botón falso que activa un input oculto real -->
        <MudButton HtmlTag="label" for="fileInput" Variant="Variant.Filled" Color="Color.Primary" Style="border-radius: 20px; cursor: pointer;">
            Explorar Archivos
        </MudButton>
        <InputFile id="fileInput" OnChange="ProcesarArchivo" accept=".png, .jpg, .jpeg, .webp" style="display: none;" />
    }
    else
    {
        <!-- FASE 2: EL ESTUDIO DE RECORTE -->
        <MudText Typo="Typo.subtitle2" Style="color: #E91E63; font-weight: bold;" Class="mb-2">Ajusta el recuadro a tu gusto</MudText>
        
        <div style="height: 300px; width: 100%; border-radius: 8px; overflow: hidden; margin-bottom: 1rem;">
            <CropperComponent @ref="_cropper" 
                              Src="@_imagenSeleccionada" 
                              Options="_opcionesCropper" />
        </div>

        <div class="d-flex justify-center gap-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancelar" Style="border-radius: 20px;" Disabled="_subiendo">
                Cancelar
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="RecortarYSubir" Style="border-radius: 20px;" Disabled="_subiendo">
                @if (_subiendo)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Subiendo...</MudText>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Crop" Class="mr-2" />
                    <MudText>Recortar y Subir</MudText>
                }
            </MudButton>
        </div>
    }
</MudPaper>

@code {
    [Parameter] public EventCallback<string> OnImagenSubida { get; set; }

    private CropperComponent? _cropper;
    private string _imagenSeleccionada = string.Empty;
    private bool _subiendo = false;

    private Options _opcionesCropper = new Options
    {
        AspectRatio = 1, 
        ViewMode = ViewMode.Vm1, 
        DragMode = "move", 
        AutoCropArea = 0.8m 
    };

    private async Task ProcesarArchivo(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo != null)
        {
            var buffer = new byte[archivo.Size];
            await archivo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            _imagenSeleccionada = $"data:{archivo.ContentType};base64,{base64}";
        }
    }

    private void Cancelar()
    {
        _imagenSeleccionada = string.Empty;
    }

    private async Task RecortarYSubir()
    {
        if (_cropper == null) return;
        _subiendo = true;

        try
        {
            // 🔥 FIX 1: La calidad ahora se pasa como un texto en minúsculas ("high", "medium" o "low")
            var opcionesDeRecorte = new GetCroppedCanvasOptions
            {
                ImageSmoothingEnabled = true,
                ImageSmoothingQuality = "high" 
            };

            // 🔥 FIX 2: Silenciamos temporalmente la advertencia para mantener tu terminal impecable (en verde)
#pragma warning disable CS0618
            var urlRecortada = await _cropper.GetCroppedCanvasDataURLAsync(opcionesDeRecorte);
#pragma warning restore CS0618

            var base64Data = urlRecortada.Split(',')[1];
            var bytes = Convert.FromBase64String(base64Data);

            using var contenidoFormulario = new MultipartFormDataContent();
            var contenidoArchivo = new ByteArrayContent(bytes);
            contenidoArchivo.Headers.ContentType = MediaTypeHeaderValue.Parse("image/png");
            
            contenidoFormulario.Add(contenidoArchivo, "archivo", "imagen_recortada.png");

            var response = await Http.PostAsync("api/upload/imagen", contenidoFormulario);

            if (response.IsSuccessStatusCode)
            {
                var resultado = await response.Content.ReadFromJsonAsync<RespuestaSubida>();
                if (resultado != null && !string.IsNullOrEmpty(resultado.Url))
                {
                    Snackbar.Add("¡Imagen subida con éxito!", Severity.Success);
                    _imagenSeleccionada = string.Empty; 
                    
                    await OnImagenSubida.InvokeAsync(resultado.Url);
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al subir: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fallo de conexión: {ex.Message}", Severity.Error);
        }
        finally
        {
            _subiendo = false;
        }
    }

    private class RespuestaSubida
    {
        public string Url { get; set; } = string.Empty;
    }
}