@using TiempoBiblia.Client.Models
@using MudBlazor
@inject IJSRuntime _js
@inject TiempoBiblia.Client.Services.CarritoService Carrito
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HttpClient Http

<MudDialog Class="netflix-modal-dialog">
    <DialogContent>
        <!-- CABECERA: Contenedor Relativo para agrupar todo -->
        <div style="position: relative; height: 400px; width: 100%; overflow: hidden;">
            
            <!-- 🔥 BOTÓN DE CERRAR FIJO EN LA ESQUINA -->
            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                           OnClick="Cancelar" 
                           Style="position: absolute; top: 12px; left: 12px; z-index: 10; background-color: rgba(255, 255, 255, 0.8); color: #333; box-shadow: 0 4px 6px rgba(0,0,0,0.2);" 
                           Size="Size.Medium" />

            <!-- CARRUSEL DE FONDO -->
            <MudCarousel Class="mud-width-full" 
                         Style="height: 400px; position: absolute; inset: 0; z-index: 1;" 
                         ShowArrows="@(todasLasImagenes.Count > 1)" 
                         ShowBullets="@(todasLasImagenes.Count > 1)" 
                         AutoCycle="true"
                         AutoCycleTime="TimeSpan.FromSeconds(2.5)"
                         TData="object">
                @foreach (var img in todasLasImagenes)
                {
                    <MudCarouselItem Transition="Transition.Fade">
                        <div style="background-image: url('@img'); height: 100%; width: 100%; background-size: cover; background-position: center;"></div>
                    </MudCarouselItem>
                }
            </MudCarousel>

            <!-- Gradiente oscuro -->
            <div class="modal-hero-overlay" style="z-index: 2;"></div>
            
            <!-- 🔥 CONTENIDO: Izquierda en PC, Centrado en Móvil -->
            <div class="modal-hero-content responsive-hero-content" style="z-index: 3;">
                <MudText Typo="Typo.h3" Class="fuente-pacifico titulo-modal" Style="color: white; text-shadow: 2px 2px 6px rgba(0,0,0,0.8); line-height: 1.2;">
                    @Producto.Nombre
                </MudText>
                
                <!-- 🔥 NUEVO: ESTRELLAS GRANDES EN EL DETALLE -->
                <div class="d-flex align-center mt-1">
                    <MudRating SelectedValue="@Producto.PromedioCalificacion" MaxValue="5" ReadOnly="true" Size="Size.Medium" Color="Color.Warning" />
                    <MudText Typo="Typo.body2" Class="ml-2" Style="color: white; text-shadow: 1px 1px 4px rgba(0,0,0,0.8); font-weight: bold;">
                        (@Producto.TotalResenas reseñas)
                    </MudText>
                </div>

                @if (!string.IsNullOrEmpty(Producto.Tipo) && (Producto.Tipo.Equals("Serie", StringComparison.OrdinalIgnoreCase) || Producto.Tipo.Equals("Miniserie", StringComparison.OrdinalIgnoreCase)))
                {
                    <MudText Typo="Typo.h6" Style="color: #F8BBD0; text-shadow: 1px 1px 4px rgba(0,0,0,0.8); font-weight: bold;" Class="mt-1">
                        (@Producto.Tipo.ToLower())
                    </MudText>
                }

                <div class="mt-4 responsive-btn-container">
                    <MudButton Variant="Variant.Filled" 
                               StartIcon="@(Producto.EsGratuito ? Icons.Material.Filled.CloudDownload : Icons.Material.Filled.ShoppingCart)" 
                               Class="btn-comprar-modal"
                               Style="background-color: #E91E63; color: white; font-weight: bold; box-shadow: 0 4px 10px rgba(233, 30, 99, 0.4);"
                               OnClick="AgregarYNotificar">
                        @(Producto.EsGratuito ? "Añadir Gratis" : $"Comprar por ${Producto.Precio}")
                    </MudButton>
                </div>
            </div>
        </div>

        <!-- CUERPO: Detalles y Tags -->
        <div class="modal-body-container">
            <MudGrid>
                <!-- Información textual (8 columnas PC, 12 Móvil) -->
                <MudItem xs="12" md="8" Class="responsive-text-center">
                    <MudText Typo="Typo.body1" Style="font-size: 1.1rem; color: #5D4037;" Class="mb-6 mt-2 text-justify-pc">
                        @Producto.Descripcion
                    </MudText>
                </MudItem>
                
                <!-- Categorías y Tags (4 columnas PC, 12 Móvil) -->
                <MudItem xs="12" md="4" Class="responsive-text-center">
                    <MudText Typo="Typo.caption" Style="color: #999; font-weight: bold;">Categoría Principal:</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: #5D4037;">@Producto.Categoria?.Nombre</MudText>

                    <MudText Typo="Typo.caption" Style="color: #999; font-weight: bold;">Etiquetas (Tags):</MudText>
                    <div class="d-flex flex-wrap gap-1 mt-2 mb-2 responsive-flex-center">
                        @if(Producto.ProductoTags != null && Producto.ProductoTags.Any())
                        {
                            @foreach (var pt in Producto.ProductoTags.Take(5))
                            {
                                @if (pt.Tag != null)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Style="border-width: 1px;">@pt.Tag.Nombre</MudChip>
                                }
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="color: gray;">Sin etiquetas</MudText>
                        }
                    </div>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-6" Style="background-color: #F48FB1; opacity: 0.3;" />

            <!-- SECCIÓN: Relacionados (More Like This) -->
            <MudText Typo="Typo.h6" Class="responsive-text-center" Style="font-weight: bold; margin-bottom: 1.5rem; color: #E91E63;">
                Similares a este título
            </MudText>
            
            <MudGrid Class="responsive-grid-center" Spacing="3">
                @if(Producto.ProductosRelacionadosOrigen != null && Producto.ProductosRelacionadosOrigen.Any())
                {
                    @foreach(var relacionado in Producto.ProductosRelacionadosOrigen)
                    {
                        var prodDestino = relacionado.ProductoRelacionadoDestino;
                        if (prodDestino == null) continue;

                        var posterRelacionado = string.IsNullOrEmpty(prodDestino.ImagenUrl) ? $"https://dummyimage.com/400x225/FCE4EC/e91e63.png&text={prodDestino.Nombre}" : prodDestino.ImagenUrl;

                        <MudItem xs="6" sm="4" md="3" Class="d-flex justify-center">
                            <MudPaper Elevation="2" Style="background-color: white; border-radius: 12px; overflow: hidden; cursor: pointer; transition: transform 0.2s ease; width: 100%; max-width: 180px;" Class="hover-zoom"
                                      @onclick="@(() => AbrirProductoRelacionado(prodDestino.Id))">
                                <img src="@posterRelacionado" style="width: 100%; height: 120px; object-fit: cover;" alt="@prodDestino.Nombre" />
                                <div style="padding: 0.8rem;" class="text-center">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: bold; line-height: 1.2; color: #5D4037;" Class="mb-1">@prodDestino.Nombre</MudText>
                                    @if(prodDestino.EsGratuito)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: bold;">Free</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Style="color: #E91E63; font-weight: bold;">$@prodDestino.Precio</MudText>
                                    }
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="responsive-text-center" Style="color: gray; font-style: italic; width: 100%;">No hay títulos similares en este momento.</MudText>
                }
            </MudGrid>

            <!-- ========================================== -->
            <!-- 🔥 NUEVA SECCIÓN: SISTEMA DE RESEÑAS      -->
            <!-- ========================================== -->
            <MudDivider Class="my-10" Style="background-color: #F48FB1; opacity: 0.3;" />
            
            <MudText Typo="Typo.h6" Class="responsive-text-center" Style="font-weight: bold; margin-bottom: 1.5rem; color: #E91E63;">
                Opiniones de nuestra comunidad ⭐
            </MudText>

            <MudGrid>
                <!-- COLUMNA IZQUIERDA: FORMULARIO -->
                <MudItem xs="12" md="4">
                    <MudPaper Elevation="2" Class="pa-6" Style="border-radius: 16px; background-color: white;">
                        <MudText Typo="Typo.subtitle1" Style="color: #5D4037; font-weight: bold;" Class="mb-2">
                            ¿Ya lo descargaste?
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mb-4" Style="color: #888;">
                            Cuéntanos qué te pareció este recurso y ayuda a otros a decidirse.
                        </MudText>

                        <EditForm Model="_nuevaResena" OnValidSubmit="EnviarResena">
                            <DataAnnotationsValidator />

                            <div class="mb-4 text-center">
                                <MudText Typo="Typo.caption" Style="color: #888;">Tu calificación:</MudText><br/>
                                <MudRating @bind-SelectedValue="_nuevaResena.Calificacion" MaxValue="5" Color="Color.Warning" Size="Size.Large" />
                                <ValidationMessage For="@(() => _nuevaResena.Calificacion)" />
                            </div>

                            <MudTextField @bind-Value="_nuevaResena.NombreCliente" Label="Tu Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                            <ValidationMessage For="@(() => _nuevaResena.NombreCliente)" />

                            <MudTextField @bind-Value="_nuevaResena.Comentario" Label="Tu Comentario" Variant="Variant.Outlined" Lines="3" Margin="Margin.Dense" Class="mb-4" />
                            <ValidationMessage For="@(() => _nuevaResena.Comentario)" />

                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Style="border-radius: 20px;" Disabled="_enviandoResena">
                                @if (_enviandoResena)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                                    <MudText Class="ms-2">Enviando...</MudText>
                                }
                                else
                                {
                                    <MudText>Publicar Reseña</MudText>
                                }
                            </MudButton>
                        </EditForm>
                    </MudPaper>
                </MudItem>

                <!-- COLUMNA DERECHA: LISTA DE RESEÑAS -->
                <MudItem xs="12" md="8">
                    @if (_cargandoResenas)
                    {
                        <div class="d-flex justify-center my-8">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        </div>
                    }
                    else if (!_listaResenas.Any())
                    {
                        <MudPaper Elevation="0" Class="pa-8 text-center" Style="border: 2px dashed #FCE4EC; border-radius: 16px; background-color: transparent;">
                            <MudIcon Icon="@Icons.Material.Filled.RateReview" Size="Size.Large" Style="color: #F8BBD0;" Class="mb-3"/>
                            <MudText Typo="Typo.h6" Style="color: #8D6E63;">Aún no hay opiniones</MudText>
                            <MudText Typo="Typo.body2" Style="color: #999;">¡Sé el primero en calificar este recurso!</MudText>
                        </MudPaper>
                    }
                    else
                    {
                        <div style="max-height: 400px; overflow-y: auto; padding-right: 10px;">
                            @foreach (var resena in _listaResenas)
                            {
                                <MudPaper Elevation="0" Class="pa-4 mb-4" Style="border-radius: 12px; border-left: 4px solid #F48FB1; background-color: white;">
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: bold; color: #5D4037;">
                                            <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Size="Size.Small" Class="mr-1" />
                                            @resena.NombreCliente
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="color: #999;">
                                            @resena.FechaCreacion.ToString("dd MMM yyyy")
                                        </MudText>
                                    </div>
                                    <MudRating SelectedValue="@resena.Calificacion" MaxValue="5" ReadOnly="true" Color="Color.Warning" Size="Size.Small" Class="mb-2" />
                                    <MudText Typo="Typo.body2" Style="color: #424242; font-style: italic;">
                                        "@resena.Comentario"
                                    </MudText>
                                </MudPaper>
                            }
                        </div>
                    }
                </MudItem>
            </MudGrid>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ProductoDto Producto { get; set; } = new();

    private List<string> todasLasImagenes = new();

    // ==========================================
    // 🔥 VARIABLES PARA EL SISTEMA DE RESEÑAS
    // ==========================================
    private List<ResenaDto> _listaResenas = new();
    private CrearResenaDto _nuevaResena = new();
    private bool _cargandoResenas = true;
    private bool _enviandoResena = false;

    // 🔥 MODIFICADO: Cambiamos a OnParametersSetAsync para manejar peticiones HTTP
    protected override async Task OnParametersSetAsync()
    {
        todasLasImagenes.Clear();
        var mainImg = string.IsNullOrEmpty(Producto.ImagenUrl) ? "images/default.jpg" : Producto.ImagenUrl;
        todasLasImagenes.Add(mainImg);
        
        if (Producto.ImagenesSecundarias != null && Producto.ImagenesSecundarias.Any())
        {
            todasLasImagenes.AddRange(Producto.ImagenesSecundarias.Select(i => i.Url));
        }

        // Preparamos el ID del producto para el formulario de reseñas
        _nuevaResena.ProductoId = Producto.Id;
        
        await CargarResenasAsync();
    }

    private void Cancelar() => MudDialog.Cancel();

    private void AgregarYNotificar()
    {
        Carrito.AgregarAlCarrito(Producto);
        Snackbar.Add($"¡{Producto.Nombre} se agregó al carrito!", Severity.Success);
    }

    private async Task AbrirProductoRelacionado(int idProducto)
    {
        try
        {
            var productoCompleto = await Http.GetFromJsonAsync<ProductoDto>($"api/Productos/{idProducto}");
            if (productoCompleto != null)
            {
                MudDialog.Close();
                var parameters = new DialogParameters<ProductoDetalleModal> { { x => x.Producto, productoCompleto } };
                var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true, BackgroundClass = "netflix-modal-backdrop" };
                await DialogService.ShowAsync<ProductoDetalleModal>("", parameters, options);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Hubo un error al cargar el producto relacionado.", Severity.Error);
        }
    }

    // ==========================================
    // 🔥 LÓGICA DE RESEÑAS
    // ==========================================
    private async Task CargarResenasAsync()
    {
        try
        {
            _cargandoResenas = true;
            _listaResenas = await Http.GetFromJsonAsync<List<ResenaDto>>($"api/resenas/producto/{Producto.Id}") ?? new List<ResenaDto>();

            // 🔥 MAGIA MATEMÁTICA: Recalculamos promedios en tiempo real
            if (_listaResenas.Any())
            {
                Producto.TotalResenas = _listaResenas.Count;
                // Calculamos el promedio y usamos Math.Ceiling para redondear siempre hacia arriba
                double promedioReal = _listaResenas.Average(r => r.Calificacion);
                Producto.PromedioCalificacion = (int)Math.Ceiling(promedioReal);
            }
            else
            {
                // Tu regla de negocio: Si no hay, 5 estrellas
                Producto.TotalResenas = 0;
                Producto.PromedioCalificacion = 5;
            }
            
            StateHasChanged(); // Forzamos a repintar el UI
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar reseñas: {ex.Message}");
        }
        finally
        {
            _cargandoResenas = false;
        }
    }

    private async Task EnviarResena()
    {
        try
        {
            _enviandoResena = true;
            
            var response = await Http.PostAsJsonAsync("api/resenas", _nuevaResena);
            
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("¡Gracias por tu opinión!", Severity.Success);
                
                // Reiniciamos el formulario conservando las 5 estrellas por defecto
                _nuevaResena = new CrearResenaDto { ProductoId = Producto.Id, Calificacion = 5 };
                
                // Recargamos la lista visual de reseñas
                await CargarResenasAsync(); 
            }
            else
            {
                Snackbar.Add("Hubo un error al publicar tu reseña.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fallo de conexión al enviar la reseña: {ex.Message}", Severity.Error);
        }
        finally
        {
            _enviandoResena = false;
        }
    }
}