@using TiempoBiblia.Client.Models
@using MudBlazor
@inject IJSRuntime _js
@inject TiempoBiblia.Client.Services.CarritoService Carrito
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HttpClient Http

<MudDialog Class="netflix-modal-dialog">
    <DialogContent>
        <!-- CABECERA: Contenedor Relativo para agrupar todo -->
        <div style="position: relative; height: 400px; width: 100%; overflow: hidden;">
            
            <!-- 🔥 BOTÓN DE CERRAR FIJO EN LA ESQUINA -->
            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                           OnClick="Cancelar" 
                           Style="position: absolute; top: 12px; left: 12px; z-index: 10; background-color: rgba(255, 255, 255, 0.8); color: #333; box-shadow: 0 4px 6px rgba(0,0,0,0.2);" 
                           Size="Size.Medium" />

            <!-- CARRUSEL DE FONDO -->
            <MudCarousel Class="mud-width-full" 
                         Style="height: 400px; position: absolute; inset: 0; z-index: 1;" 
                         ShowArrows="@(todasLasImagenes.Count > 1)" 
                         ShowBullets="@(todasLasImagenes.Count > 1)" 
                         AutoCycle="true" 
                         TData="object">
                @foreach (var img in todasLasImagenes)
                {
                    <MudCarouselItem Transition="Transition.Fade">
                        <div style="background-image: url('@img'); height: 100%; width: 100%; background-size: cover; background-position: center;"></div>
                    </MudCarouselItem>
                }
            </MudCarousel>

            <!-- Gradiente oscuro -->
            <div class="modal-hero-overlay" style="z-index: 2;"></div>
            
            <!-- 🔥 CONTENIDO: Izquierda en PC, Centrado en Móvil -->
            <div class="modal-hero-content responsive-hero-content" style="z-index: 3;">
                <MudText Typo="Typo.h3" Class="fuente-pacifico titulo-modal" Style="color: white; text-shadow: 2px 2px 6px rgba(0,0,0,0.8); line-height: 1.2;">
                    @Producto.Nombre
                </MudText>

                @if (!string.IsNullOrEmpty(Producto.Tipo) && (Producto.Tipo.Equals("Serie", StringComparison.OrdinalIgnoreCase) || Producto.Tipo.Equals("Miniserie", StringComparison.OrdinalIgnoreCase)))
                {
                    <MudText Typo="Typo.h6" Style="color: #F8BBD0; text-shadow: 1px 1px 4px rgba(0,0,0,0.8); font-weight: bold;" Class="mt-1">
                        (@Producto.Tipo.ToLower())
                    </MudText>
                }

                <div class="mt-4 responsive-btn-container">
                    <MudButton Variant="Variant.Filled" 
                               StartIcon="@(Producto.EsGratuito ? Icons.Material.Filled.CloudDownload : Icons.Material.Filled.ShoppingCart)" 
                               Class="btn-comprar-modal"
                               Style="background-color: #E91E63; color: white; font-weight: bold; box-shadow: 0 4px 10px rgba(233, 30, 99, 0.4);"
                               OnClick="AgregarYNotificar">
                        @(Producto.EsGratuito ? "Añadir Gratis" : $"Comprar por ${Producto.Precio}")
                    </MudButton>
                </div>
            </div>
        </div>

        <!-- CUERPO: Detalles y Tags -->
        <div class="modal-body-container">
            <MudGrid>
                <!-- Información textual (8 columnas PC, 12 Móvil) -->
                <MudItem xs="12" md="8" Class="responsive-text-center">
                    <MudText Typo="Typo.body1" Style="font-size: 1.1rem; color: #5D4037;" Class="mb-6 mt-2 text-justify-pc">
                        @Producto.Descripcion
                    </MudText>
                </MudItem>
                
                <!-- Categorías y Tags (4 columnas PC, 12 Móvil) -->
                <MudItem xs="12" md="4" Class="responsive-text-center">
                    <MudText Typo="Typo.caption" Style="color: #999; font-weight: bold;">Categoría Principal:</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="color: #5D4037;">@Producto.Categoria?.Nombre</MudText>

                    <MudText Typo="Typo.caption" Style="color: #999; font-weight: bold;">Etiquetas (Tags):</MudText>
                    <div class="d-flex flex-wrap gap-1 mt-2 mb-2 responsive-flex-center">
                        @if(Producto.ProductoTags != null && Producto.ProductoTags.Any())
                        {
                            @foreach (var pt in Producto.ProductoTags.Take(5))
                            {
                                @if (pt.Tag != null)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Style="border-width: 1px;">@pt.Tag.Nombre</MudChip>
                                }
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="color: gray;">Sin etiquetas</MudText>
                        }
                    </div>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-6" Style="background-color: #F48FB1; opacity: 0.3;" />

            <!-- SECCIÓN: Relacionados (More Like This) -->
            <MudText Typo="Typo.h6" Class="responsive-text-center" Style="font-weight: bold; margin-bottom: 1.5rem; color: #E91E63;">
                Similares a este título
            </MudText>
            
            <MudGrid Class="responsive-grid-center" Spacing="3">
                @if(Producto.ProductosRelacionadosOrigen != null && Producto.ProductosRelacionadosOrigen.Any())
                {
                    @foreach(var relacionado in Producto.ProductosRelacionadosOrigen)
                    {
                        var prodDestino = relacionado.ProductoRelacionadoDestino;
                        if (prodDestino == null) continue;

                        var posterRelacionado = string.IsNullOrEmpty(prodDestino.ImagenUrl) ? $"https://dummyimage.com/400x225/FCE4EC/e91e63.png&text={prodDestino.Nombre}" : prodDestino.ImagenUrl;

                        <MudItem xs="6" sm="4" md="3" Class="d-flex justify-center">
                            <MudPaper Elevation="2" Style="background-color: white; border-radius: 12px; overflow: hidden; cursor: pointer; transition: transform 0.2s ease; width: 100%; max-width: 180px;" Class="hover-zoom"
                                      @onclick="@(() => AbrirProductoRelacionado(prodDestino.Id))">
                                <img src="@posterRelacionado" style="width: 100%; height: 120px; object-fit: cover;" alt="@prodDestino.Nombre" />
                                <div style="padding: 0.8rem;" class="text-center">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: bold; line-height: 1.2; color: #5D4037;" Class="mb-1">@prodDestino.Nombre</MudText>
                                    @if(prodDestino.EsGratuito)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: bold;">Free</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Style="color: #E91E63; font-weight: bold;">$@prodDestino.Precio</MudText>
                                    }
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="responsive-text-center" Style="color: gray; font-style: italic; width: 100%;">No hay títulos similares en este momento.</MudText>
                }
            </MudGrid>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ProductoDto Producto { get; set; } = new();

    private List<string> todasLasImagenes = new();

    protected override void OnParametersSet()
    {
        todasLasImagenes.Clear();
        var mainImg = string.IsNullOrEmpty(Producto.ImagenUrl) ? "images/default.jpg" : Producto.ImagenUrl;
        todasLasImagenes.Add(mainImg);
        
        if (Producto.ImagenesSecundarias != null && Producto.ImagenesSecundarias.Any())
        {
            todasLasImagenes.AddRange(Producto.ImagenesSecundarias.Select(i => i.Url));
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private void AgregarYNotificar()
    {
        Carrito.AgregarAlCarrito(Producto);
        Snackbar.Add($"¡{Producto.Nombre} se agregó al carrito!", Severity.Success);
        MudDialog.Close(); 
    }

    private async Task AbrirProductoRelacionado(int idProducto)
    {
        try
        {
            var productoCompleto = await Http.GetFromJsonAsync<ProductoDto>($"api/Productos/{idProducto}");
            if (productoCompleto != null)
            {
                MudDialog.Close();
                var parameters = new DialogParameters<ProductoDetalleModal> { { x => x.Producto, productoCompleto } };
                var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true, BackgroundClass = "netflix-modal-backdrop" };
                await DialogService.ShowAsync<ProductoDetalleModal>("", parameters, options);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Hubo un error al cargar el producto relacionado.", Severity.Error);
        }
    }
}