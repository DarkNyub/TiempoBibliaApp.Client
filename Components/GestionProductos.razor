@using TiempoBiblia.Client.Models
@using System.Text.RegularExpressions
@inject HttpClient Http
@inject IJSRuntime _js
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="">
    @if (productos == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudTable Items="@productos"RowsPerPage="20" Dense="true" Filter="new Func<ProductoDto,bool>(Filtrar)" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="4" Style="border-radius: 12px; overflow: hidden;">
            <ToolBarContent>
                <MudButton Size="Size.Small"  Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirModalCreacion">
                    Nuevo Producto
                </MudButton>
                <MudSpacer />
                <MudText Typo="Typo.h6">Catálogo</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="textoBusqueda" Immediate="true" Placeholder="Buscar producto..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Class="mt-0" Margin="Margin.Dense" />
            </ToolBarContent>
            
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<ProductoDto, object>(x => x.Id)">Id</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ProductoDto, object>(x => x.Nombre)">Nombre</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ProductoDto, object>(x => x.Precio)">Precio</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ProductoDto, object>(x => x.PrecioUsd)">Precio USD</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ProductoDto, object>(x => x.Tipo)">Tipo</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<ProductoDto, object>(x => x.Activo)">Estado</MudTableSortLabel></MudTh>
                <MudTh Style="text-align: right;">Acciones</MudTh>
            </HeaderContent>
            
            <RowTemplate>
                <MudTd DataLabel="Id"><strong>@context.Id</strong></MudTd>
                <MudTd DataLabel="Nombre"><strong>@context.Nombre</strong></MudTd>
                <MudTd DataLabel="Precio">@(context.EsGratuito ? "Gratis" : $"${context.Precio}")</MudTd>
                <MudTd DataLabel="Precio">@(context.EsGratuito ? "Gratis" : $"${context.PrecioUsd}")</MudTd>
                <MudTd DataLabel="Tipo">
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">@context.Tipo</MudChip>
                </MudTd>
                <!-- 🔥 NUEVO SWITCH INTERACTIVO -->
                <MudTd DataLabel="Estado">
                    <MudSwitch  Size="Size.Small" T="bool" Value="@context.Activo" ValueChanged="@((bool val) => CambiarEstadoProducto(context, val))" Color="Color.Success" />
                </MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: right;">
                    <MudIconButton Size="Size.Small"  Icon="@Icons.Material.Filled.Link" Color="Color.Info" title="Generar Link" OnClick="() => PrepararGeneracionLink(context)" />
                    <MudIconButton Size="Size.Small"  Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" title="Editar" OnClick="() => AbrirModalEdicion(context)" />
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Star" Color="Color.Warning" title="Moderar Reseñas" OnClick="() => AbrirModalResenas(context)" />
                    <MudIconButton Size="Size.Small"  Icon="@Icons.Material.Filled.Delete" Color="Color.Error" title="Eliminar" OnClick="() => EliminarProducto(context)" />
                </MudTd>
            </RowTemplate>
            
            <PagerContent>
                <MudTablePager HideRowsPerPage="true" />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

<!-- MODAL PARA GENERAR LINK -->
<MudDialog @bind-Visible="mostrarModalLink" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.subtitle1">Generar acceso para: <strong>@productoSeleccionado?.Nombre</strong></MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="requestLink.CorreoCliente" Label="Referencia (Ej: +57 300...)" Variant="Variant.Outlined" AutoFocus="true"  Margin="Margin.Dense" />
        @if (!string.IsNullOrEmpty(linkGenerado))
        {
            <MudAlert Severity="Severity.Success" Class="mt-4 mb-4">Link mágico creado (Expira en 24h)</MudAlert>
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudTextField Value="@linkGenerado" Variant="Variant.Outlined" ReadOnly="true" Margin="Margin.Dense" />
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" Variant="Variant.Filled" OnClick="CopiarAlPortapapeles" Size="Size.Small"/>
            </MudStack>
        }
        <hr />
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="() => mostrarModalLink = false">Cerrar</MudButton>
        <MudButton Size="Size.Small" OnClick="GenerarLinkSeguro" Color="Color.Primary" Variant="Variant.Filled">Crear Link</MudButton>
    </DialogActions>
</MudDialog>

<!-- 🔥 SÚPER MODAL DE CREACIÓN / EDICIÓN -->
<MudDialog @bind-Visible="mostrarModalEdicion" Options="dialogOptionsEdicion">
    <TitleContent>
        <MudText Typo="Typo.h6">@(productoEditando?.Id == 0 ? "Crear Nuevo Producto" : "Editar Producto")</MudText>
    </TitleContent>
    <DialogContent>
        @if (productoEditando != null)
        {
            <MudGrid Spacing="2">
                <!-- COLUMNA IZQUIERDA: Datos Básicos -->
                <MudItem xs="12" md="6" Class="fontsize87">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">Información Básica</MudText>
                    <MudTextField @bind-Value="productoEditando.Nombre" Label="Nombre del Producto*" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"  Style="font-size: 0.875rem;" />
                    <MudTextField @bind-Value="productoEditando.Descripcion" Label="Descripción" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"  Style="font-size: 0.875rem;" />
                    
                    <MudGrid Spacing="1" Class="mb-2">
                        <MudItem xs="4">
                            <MudCheckBox @bind-Value="productoEditando.EsGratuito" Label="Gratis?" Color="Color.Success"  Style="font-size: 0.875rem;" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="productoEditando.Precio" Label="Precio (COP)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="productoEditando.EsGratuito" Style="font-size: 0.875rem;"  />
                        </MudItem>
                        <MudItem xs="4">
                            <MudNumericField @bind-Value="productoEditando.PrecioUsd" Label="Precio (USD)" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="productoEditando.EsGratuito" Style="font-size: 0.875rem;"  />
                        </MudItem>
                    </MudGrid>

                    <MudTextField @bind-Value="productoEditando.Tipo" Label="Tipo (Formato)" Placeholder="Ej. Serie, Miniserie, Imprimible..." Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Style="font-size: 0.875rem;"  />

                    <SubidorImagen/>
                </MudItem>

                <!-- COLUMNA DERECHA: Relaciones Mágicas -->
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">Organización y Enlaces</MudText>
                    
                    <MudSelect T="int" @bind-Value="productoEditando.CategoriaId" Label="Categoría Principal" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                               ToStringFunc="@(id => id == 0 ? "Seleccione una categoría..." : categoriasDisponibles?.FirstOrDefault(c => c.Id == id)?.Nombre ?? "Desconocido")">
                        <MudSelectItem T="int" Value="0">Seleccione...</MudSelectItem>
                        @if (categoriasDisponibles != null)
                        {
                            @foreach (var cat in categoriasDisponibles.Where(x => x.Activo))
                            {
                                <MudSelectItem T="int" Value="@cat.Id">@cat.Nombre</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="productoEditando.CategoriasSecundariasIds" Label="Categorías Secundarias" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                               MultiSelectionTextFunc="@( _ => ObtenerNombresCategorias(productoEditando.CategoriasSecundariasIds) )">
                        @if (categoriasDisponibles != null)
                        {
                            @foreach (var cat in categoriasDisponibles.Where(x => x.Activo))
                            {
                                <MudSelectItem T="int" Value="@cat.Id">@cat.Nombre</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="productoEditando.TagsIds" Label="Palabras Claves" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                               MultiSelectionTextFunc="@( _ => ObtenerNombresTags(productoEditando.TagsIds) )">
                        @if (tagsDisponibles != null)
                        {
                            @foreach (var tag in tagsDisponibles.Where(x => x.Activo))
                            {
                                <MudSelectItem T="int" Value="@tag.Id">@tag.Nombre</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="productoEditando.ProductosRelacionadosIds" Label="Productos Similares / Relacionados" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                               MultiSelectionTextFunc="@( _ => ObtenerNombresProductos(productoEditando.ProductosRelacionadosIds) )">
                        @if (productos != null)
                        {
                            @foreach (var p in productos.Where(x => x.Id != productoEditando.Id && x.Activo))
                            {
                                <MudSelectItem T="int" Value="@p.Id">@p.Nombre</MudSelectItem>
                            }
                        }
                    </MudSelect>

                    <MudTextField @bind-Value="productoEditando.ImagenUrl" Label="URL de la Imagen Principal" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.OpenInNew" AdornmentColor="Color.Info" OnAdornmentClick="@(() => AbrirUrl(productoEditando.ImagenUrl))" title="Probar enlace" />
                    
                    <MudTextField @bind-Value="productoEditando.PdfUrl" Label="URL del Drive (El imprimible)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" HelperText="Pega el link de compartir, se formateará solo." 
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.OpenInNew" AdornmentColor="Color.Info" 
                                  OnAdornmentClick="@(() => AbrirUrl(productoEditando.PdfUrl))" title="Probar enlace" />

                    <MudTextField @bind-Value="productoEditando.VideoUrl" Label="URL del Video (El tutorial)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" 
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.OpenInNew" AdornmentColor="Color.Info" 
                                  OnAdornmentClick="@(() => AbrirUrl(productoEditando.VideoUrl))" title="Probar enlace" />
                    
                    <MudTextField @bind-Value="textoImagenesSecundarias" Label="Otras Imágenes (Para el Carrusel)" Placeholder="Pega los links separados por coma (,)" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" HelperText="Ej: url1.jpg, url2.png" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="() => mostrarModalEdicion = false">Cancelar</MudButton>
        <MudButton Size="Size.Small" OnClick="GuardarProducto" Color="Color.Primary" Variant="Variant.Filled">
            @(productoEditando?.Id == 0 ? "Crear Producto" : "Guardar Cambios")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- 🔥 MODAL DE GESTIÓN DE RESEÑAS -->
<MudDialog @bind-Visible="mostrarModalResenas" Options="new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Moderación de Reseñas: <strong>@productoSeleccionadoParaResenas?.Nombre</strong></MudText>
    </TitleContent>
    <DialogContent>
        @if (resenasDelProducto == null)
        {
            <MudProgressLinear Color="Color.Warning" Indeterminate="true" />
        }
        else if (!resenasDelProducto.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mt-2 mb-4">Este producto aún no tiene reseñas de la comunidad.</MudAlert>
        }
        else
        {
            <MudTable Items="@resenasDelProducto" Dense="true" Hover="true" Elevation="0" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
                <HeaderContent>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Valoración</MudTh>
                    <MudTh>Comentario</MudTh>
                    <MudTh>Estado (Público)</MudTh>
                </HeaderContent>
                <RowTemplate Context="resena">
                    <MudTd DataLabel="Fecha">@resena.FechaCreacion.ToString("dd MMM yyyy")</MudTd>
                    <MudTd DataLabel="Nombre"><strong>@resena.NombreCliente</strong></MudTd>
                    <MudTd DataLabel="Valoración">
                        <MudRating SelectedValue="@resena.Calificacion" MaxValue="5" ReadOnly="true" Size="Size.Small" Color="Color.Warning" />
                    </MudTd>
                    <MudTd DataLabel="Comentario" Style="max-width: 300px; white-space: normal;">
                        <MudText Typo="Typo.body2" Style="font-style: italic;">@resena.Comentario</MudText>
                    </MudTd>
                    <MudTd DataLabel="Estado">
                        <MudSwitch T="bool" Size="Size.Small" Value="@resena.Aprobada" ValueChanged="@((bool val) => CambiarEstadoResena(resena, val))" Color="Color.Success" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="() => mostrarModalResenas = false">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<ProductoDto>? productos;
    private List<CategoriaDto>? categoriasDisponibles;
    private List<TagDto>? tagsDisponibles;
    
    private string textoBusqueda = "";
    private string textoImagenesSecundarias = "";

    private DialogOptions dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
    private DialogOptions dialogOptionsEdicion = new() { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };

    private bool mostrarModalLink = false;
    private ProductoDto? productoSeleccionado;
    private GenerarLinkRequestDto requestLink = new();
    private string linkGenerado = "";

    private bool mostrarModalEdicion = false;
    private ProductoDto? productoEditando;
    
    private bool mostrarModalResenas = false;
    private ProductoDto? productoSeleccionadoParaResenas;
    private List<ResenaDto>? resenasDelProducto;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        var data = await Http.GetFromJsonAsync<List<ProductoDto>>("api/Productos/admin");
        if (data != null)
            productos = data.OrderByDescending(p => p.Activo).ThenBy(p => p.Id).ToList();// 🔥 Primero los Activos (true), luego los inactivos (false), y por último por nombre

        categoriasDisponibles = await Http.GetFromJsonAsync<List<CategoriaDto>>("api/Categorias/admin");
        
        try {
            tagsDisponibles = await Http.GetFromJsonAsync<List<TagDto>>("api/Tags");
        } catch { 
            tagsDisponibles = new List<TagDto>(); 
        }
    }

    private bool Filtrar(ProductoDto prod) => string.IsNullOrWhiteSpace(textoBusqueda) || prod.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase);

    private string ObtenerNombresCategorias(IEnumerable<int> ids)
    {
        if (categoriasDisponibles == null || !ids.Any()) return "Ninguna";
        var nombres = categoriasDisponibles.Where(c => ids.Contains(c.Id)).Select(c => c.Nombre);
        return string.Join(", ", nombres);
    }
    
    private string ObtenerNombresTags(IEnumerable<int> ids)
    {
        if (tagsDisponibles == null || !ids.Any()) return "Ninguno";
        var nombres = tagsDisponibles.Where(t => ids.Contains(t.Id)).Select(t => t.Nombre);
        return string.Join(", ", nombres);
    }

    private string ObtenerNombresProductos(IEnumerable<int> ids)
    {
        if (productos == null || !ids.Any()) return "Ninguno";
        var nombres = productos.Where(p => ids.Contains(p.Id)).Select(p => p.Nombre);
        return string.Join(", ", nombres);
    }

    private void PrepararGeneracionLink(ProductoDto producto)
    {
        productoSeleccionado = producto;
        requestLink = new GenerarLinkRequestDto { ProductoId = producto.Id, CorreoCliente = "" };
        linkGenerado = "";
        mostrarModalLink = true;
    }

    private async Task GenerarLinkSeguro()
    {
        var response = await Http.PostAsJsonAsync("api/descargas/generar", requestLink);
        if (response.IsSuccessStatusCode)
        {
            var resultado = await response.Content.ReadFromJsonAsync<GenerarLinkResponseDto>();
            if (resultado != null)
            {
                var tokenId = new Uri(resultado.UrlSegura).Segments.Last(); 
                linkGenerado = $"{Nav.BaseUri}descargar/{tokenId}?nombre={Uri.EscapeDataString(productoSeleccionado!.Nombre)}";
            }
        }
    }

    private async Task CopiarAlPortapapeles() => await _js.InvokeVoidAsync("navigator.clipboard.writeText", linkGenerado);

    private void AbrirModalCreacion()
    {
        productoEditando = new ProductoDto
        {
            Id = 0,
            Tipo = "", 
            EsGratuito = false,
            CategoriaId = 0, 
            CategoriasSecundariasIds = new List<int>(),
            ProductosRelacionadosIds = new List<int>(),
            TagsIds = new List<int>(),
            ImagenesSecundarias = new List<ImagenProductoDto>()
        };
        textoImagenesSecundarias = ""; 
        mostrarModalEdicion = true;
    }

    private async Task AbrirModalEdicion(ProductoDto producto)
    {
        try
        {
            var prodDetalle = await Http.GetFromJsonAsync<ProductoDto>($"api/Productos/{producto.Id}");
            var prod = prodDetalle ?? producto;

            productoEditando = new ProductoDto
            {
                Id = prod.Id,
                Nombre = prod.Nombre,
                Descripcion = prod.Descripcion,
                Precio = prod.Precio,
                PrecioUsd = prod.PrecioUsd,
                Descuento = prod.Descuento,
                EsGratuito = prod.EsGratuito,
                ImagenUrl = prod.ImagenUrl,
                Tipo = prod.Tipo,
                PdfUrl = prod.PdfUrl,
                VideoUrl = prod.VideoUrl,
                Activo = prod.Activo,
                CategoriaId = prod.CategoriaId,
                
                CategoriasSecundariasIds = prod.CategoriasSecundarias?.Select(c => c.CategoriaId).ToList() ?? new List<int>(),
                ProductosRelacionadosIds = prod.ProductosRelacionadosOrigen?.Select(r => r.ProductoRelacionadoId != 0 ? r.ProductoRelacionadoId : r.ProductoRelacionadoDestino.Id).ToList() ?? new List<int>(),
                TagsIds = prod.ProductoTags?.Select(t => t.TagId).ToList() ?? new List<int>(),
                
                ImagenesSecundarias = prod.ImagenesSecundarias ?? new List<ImagenProductoDto>()
            };

            textoImagenesSecundarias = string.Join(", ", productoEditando.ImagenesSecundarias.Select(i => i.Url));
        }
        catch
        {
            Snackbar.Add("Error al cargar detalles para edición.", Severity.Warning);
        }

        mostrarModalEdicion = true;
    }

    // 🔥 NUEVO: Función que extrae el ID de Drive y arma el link de descarga directa
    private string FormatearLinkDrive(string? urlOriginal)
    {
        if (string.IsNullOrWhiteSpace(urlOriginal)) return string.Empty;
        
        // Buscamos si el link tiene el patrón clásico de Drive
        var match = Regex.Match(urlOriginal, @"drive\.google\.com/file/d/([^/]+)");
        if (match.Success)
        {
            var idDrive = match.Groups[1].Value;
            return $"https://drive.google.com/uc?export=download&id={idDrive}";
        }
        
        // Si no cumple el patrón (quizás ya está formateado o es de otra plataforma), lo devolvemos intacto
        return urlOriginal;
    }

    private async Task GuardarProducto()
    {
        if (productoEditando == null) return;

        // 🔥 1. CREAMOS NUESTRA CANASTA RECOLECTORA DE ERRORES
        List<string> errores = new List<string>();

        // Validación de Nombre (Obligatorio y Max 300 caracteres según tu DB)
        if (string.IsNullOrWhiteSpace(productoEditando.Nombre))
            errores.Add("• El Nombre del producto es obligatorio.");
        else if (productoEditando.Nombre.Length > 300)
            errores.Add("• El Nombre no puede superar los 300 caracteres.");

        // Validación de Descripción (Obligatorio)
        if (string.IsNullOrWhiteSpace(productoEditando.Descripcion))
            errores.Add("• Debes agregar una Descripción.");

        // Validación de Tipo (Obligatorio)
        if (string.IsNullOrWhiteSpace(productoEditando.Tipo))
            errores.Add("• Debes especificar el Tipo (Ej. Serie, PDF, etc).");

        // Validación de Categoría (Obligatorio)
        if (productoEditando.CategoriaId == 0)
            errores.Add("• Debes seleccionar una Categoría Principal.");

        // Validación de Precios y Gratis
        if (!productoEditando.EsGratuito && ((productoEditando.Precio  <= 0) || (productoEditando.PrecioUsd <= 0)))
            errores.Add("• Si el producto NO es gratis, el Precio debe ser mayor a 0.");

        // 🔥 2. ¿HAY ERRORES? LOS AGRUPAMOS Y MOSTRAMOS TODOS JUNTOS
        if (errores.Any())
        {
            string mensajeAgrupado = "Por favor revisa lo siguiente:\n" + string.Join("\n", errores);
            Snackbar.Add(mensajeAgrupado, Severity.Warning);
            return; // Detenemos el guardado aquí mismo
        }

        // 🔥 FORMATEAMOS EL LINK DE DRIVE AUTOMÁTICAMENTE
        productoEditando.PdfUrl = FormatearLinkDrive(productoEditando.PdfUrl);

        // Procesar imágenes secundarias
        productoEditando.ImagenesSecundarias.Clear();
        if (!string.IsNullOrWhiteSpace(textoImagenesSecundarias))
        {
            var urls = textoImagenesSecundarias.Split(',', StringSplitOptions.RemoveEmptyEntries);
            foreach (var url in urls)
            {
                var cleanUrl = url.Trim();
                if (!string.IsNullOrEmpty(cleanUrl))
                {
                    productoEditando.ImagenesSecundarias.Add(new ImagenProductoDto { Url = cleanUrl });
                }
            }
        }

        HttpResponseMessage response;

        if (productoEditando.Id == 0)
        {
            response = await Http.PostAsJsonAsync("api/Productos", productoEditando);
        }
        else
        {
            response = await Http.PutAsJsonAsync($"api/Productos/{productoEditando.Id}", productoEditando);
        }

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(productoEditando.Id == 0 ? "Producto creado exitosamente" : "Cambios guardados", Severity.Success);
            mostrarModalEdicion = false;
            await CargarDatos(); 
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Snackbar.Add($"Error: {error}", Severity.Error);
        }
    }

    private async Task EliminarProducto(ProductoDto producto)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación", 
            $"¿Estás seguro que deseas eliminar '{producto.Nombre}'?", 
            yesText: "Eliminar", cancelText: "Cancelar");

        if (result == true)
        {
            var response = await Http.DeleteAsync($"api/Productos/{producto.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Producto eliminado", Severity.Success);
                await CargarDatos();
            }
            else
            {
                Snackbar.Add("No se pudo eliminar", Severity.Error);
            }
        }
    }
    // 🔥 NUEVO: Función para probar los links abriéndolos en una nueva pestaña
    private async Task AbrirUrl(string? url)
    {
        if (!string.IsNullOrWhiteSpace(url))
        {
            // Si es un link de Drive, lo formateamos al vuelo para probar la descarga real
            string urlFinal = FormatearLinkDrive(url);
            
            // Usamos JSInterop para abrir la pestaña nueva (_blank)
            await _js.InvokeVoidAsync("window.open", urlFinal, "_blank");
        }
        else
        {
            Snackbar.Add("El campo está vacío. Pega un link primero para probarlo.", Severity.Warning);
        }
    }
    // 🔥 NUEVO: Función para encender/apagar productos con un clic
    private async Task CambiarEstadoProducto(ProductoDto prod, bool nuevoEstado)
    {
        prod.Activo = nuevoEstado;
        var response = await Http.PutAsJsonAsync($"api/Productos/{prod.Id}", prod);
        
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add($"Producto {(nuevoEstado ? "Activado" : "Inactivado")}", Severity.Success);
        }
        else
        {
            prod.Activo = !nuevoEstado; // Revertir visualmente si hay error
            Snackbar.Add("Error al cambiar el estado del producto.", Severity.Error);
        }
    }

    // 🔥 Método 1: Abre el modal y descarga las reseñas de ese producto
    private async Task AbrirModalResenas(ProductoDto producto)
    {
        productoSeleccionadoParaResenas = producto;
        mostrarModalResenas = true;
        resenasDelProducto = null; // Reiniciamos a null para que salga la barrita de carga
        
        try
        {
            // Usamos el mismo endpoint que ya consume la tienda para ver las reseñas
            resenasDelProducto = await Http.GetFromJsonAsync<List<ResenaDto>>($"api/resenas/admin/producto/{producto.Id}") ?? new List<ResenaDto>();
        }
        catch
        {
            Snackbar.Add("Error al cargar las reseñas de este producto.", Severity.Error);
            resenasDelProducto = new List<ResenaDto>();
        }
    }

    // 🔥 Método 2: Apaga o enciende la reseña en tiempo real
    private async Task CambiarEstadoResena(ResenaDto resena, bool nuevoEstado)
    {
        // ⚠️ Asumo que tu ResenaDto tiene la propiedad "Aprobada" (o cámbiala a "Activa")
        resena.Aprobada = nuevoEstado; 
        
        // Hacemos el PUT al backend para actualizar
        var response = await Http.PutAsJsonAsync($"api/resenas/{resena.Id}", resena);
        
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add($"Reseña {(nuevoEstado ? "Aprobada (Visible)" : "Ocultada")} con éxito", Severity.Success);
        }
        else
        {
            resena.Aprobada = !nuevoEstado; // Revertimos visualmente si el servidor falla
            Snackbar.Add("Error al cambiar el estado de la reseña.", Severity.Error);
        }
    }
}