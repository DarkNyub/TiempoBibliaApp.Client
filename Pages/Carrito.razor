@page "/carrito"
@using TiempoBiblia.Client.Models
@inject TiempoBiblia.Client.Services.CarritoService CarritoService
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar 

<MudContainer MaxWidth="MaxWidth.Medium" Class="pt-8 pb-16">
    <div class="d-flex align-center mb-6">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                       Color="Color.Default" 
                       OnClick="@(() => Nav.NavigateTo("/"))" 
                       Class="mr-2" />
        <MudText Typo="Typo.h4" Style="font-weight: bold; color: #5D4037;" Class="mb-0">
            Tu Carrito de Compras 🛒
        </MudText>
    </div>

    @if (!CarritoService.Items.Any())
    {
        <MudPaper Elevation="2" Class="pa-8 text-center" Style="border-radius: 20px;">
            <MudIcon Icon="@Icons.Material.Filled.RemoveShoppingCart" Size="Size.Large" Color="Color.Default" Class="mb-4" />
            <MudText Typo="Typo.h6">Tu carrito está vacío</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="border-radius: 20px;" OnClick="@(() => Nav.NavigateTo("/"))" Class="mt-4">
                Volver a la tienda
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            <!-- LISTA DE PRODUCTOS -->
            <MudItem xs="12" md="7">
                @foreach (var item in CarritoService.Items)
                {
                    <MudPaper Elevation="1" Class="pa-4 mb-4 d-flex align-center" Style="border-radius: 12px;">
                        <div style="width: 80px; height: 80px; border-radius: 8px; overflow: hidden; margin-right: 16px;">
                            <img src="@(string.IsNullOrEmpty(item.Producto.ImagenUrl) ? "images/default.jpg" : item.Producto.ImagenUrl)" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: bold;">@item.Producto.Nombre</MudText>
                            <MudText Typo="Typo.body2" Style="color: #8D6E63;">$@item.Producto.Precio</MudText>
                        </div>
                        
                        <!-- 🔥 CONTROLES OCULTABLES -->
                        <div class="d-flex align-center mx-4">
                            @if (!_aceptaTerminos)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="@(() => CarritoService.ModificarCantidad(item.Producto.Id, item.Cantidad - 1))" />
                            }
                            <MudText Class="mx-2">@item.Cantidad</MudText>
                            @if (!_aceptaTerminos)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => CarritoService.ModificarCantidad(item.Producto.Id, item.Cantidad + 1))" />
                            }
                        </div>

                        @if (!_aceptaTerminos)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => CarritoService.EliminarDelCarrito(item.Producto.Id))" />
                        }
                    </MudPaper>
                }
                
                @if (!_aceptaTerminos)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Size="Size.Large" 
                               Style="border-radius: 20px; font-weight: bold; border-width: 2px;" 
                               OnClick="@(() => Nav.NavigateTo("/"))">
                        Seguir Comprando
                    </MudButton>
                }
            </MudItem>

            <!-- ZONA DE PAGO DIRECTO (BRICKS) -->
            <MudItem xs="12" md="5">
                <MudPaper Elevation="2" Class="pa-6" Style="border-radius: 20px; background-color: #FCE4EC;">
                    <div class="d-flex justify-space-between mb-4">
                        <MudText Typo="Typo.h5" Style="font-weight: bold;">Total a Pagar:</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: bold; color: #E91E63;">$@CarritoService.ObtenerTotal()</MudText>
                    </div>

                    <MudDivider Class="my-4" />

                    <!-- 🔥 LOGICA DEL CHECKBOX: Solo se muestra si NO ha aceptado -->
                    @if (!_aceptaTerminos)
                    {
                        <MudCheckBox T="bool" ValueChanged="AceptarTerminos" Color="Color.Primary" Class="mb-4">
                            <MudText Typo="Typo.body2">
                                Acepto el tratamiento de mis datos personales según la 
                                <a href="javascript:void(0)" @onclick="AbrirTerminos" @onclick:preventDefault style="color: #E91E63; font-weight: bold; text-decoration: underline;">
                                    Política de Privacidad y Habeas Data
                                </a>.
                            </MudText>
                        </MudCheckBox>

                        <MudAlert Severity="Severity.Info" Class="mb-4">
                            Debes aceptar las políticas para habilitar el pago seguro.
                        </MudAlert>
                    }
                    else
                    {
                        <!-- Botón por si quiere arrepentirse y modificar el carrito -->
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Default" OnClick="DeshacerTerminos" Class="mb-4" FullWidth="true">
                            Modificar carrito
                        </MudButton>
                    }

                    @if (_procesandoPago)
                    {
                        <div class="d-flex flex-column align-center my-4">
                            <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
                            <MudText Class="mt-2" Style="font-weight: bold;">Procesando tu pago...</MudText>
                        </div>
                    }
                    <!-- 🚀 CONTENEDOR DE MERCADO PAGO -->
                    <div style="@(_procesandoPago || !_aceptaTerminos ? "display: none;" : "")">
                        <div id="paymentBrick_container"></div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;

    private bool _procesandoPago = false;
    private bool _aceptaTerminos = false;
    private bool _brickRendered = false;
    private DotNetObjectReference<Carrito>? _objRef;

    private async Task AbrirTerminos()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<TerminosCondicionesModal>("Términos y Condiciones", options);
    }

    private async Task AceptarTerminos(bool aceptado)
    {
        _aceptaTerminos = aceptado;

        if (_aceptaTerminos && !_brickRendered)
        {
            var total = CarritoService.ObtenerTotal();
            if (total > 0)
            {
                _objRef = DotNetObjectReference.Create(this);
                string? publicKey = Config["MercadoPago:PublicKey"]; 
                
                if (!string.IsNullOrEmpty(publicKey))
                {
                    await JS.InvokeVoidAsync("renderMercadoPagoBrick", publicKey, total, _objRef);
                    _brickRendered = true;
                }
            }
        }
    }

    private void DeshacerTerminos()
    {
        // Si el cliente quiere modificar cantidades, apagamos el flag.
        _aceptaTerminos = false;
        _brickRendered = false; // Forzamos a que vuelva a dibujar el Brick si vuelve a aceptar
    }

    [JSInvokable] 
    // 🔥 CAMBIO: Ahora devuelve Task<bool>
    public async Task<bool> ProcesarPago(object formDataBricks) 
    {
        try
        {
            _procesandoPago = true;
            StateHasChanged(); 

            var response = await Http.PostAsJsonAsync("api/checkout/procesar-pago-brick", formDataBricks);
            
            if (response.IsSuccessStatusCode)
            {
                // 🔥 Extraemos la respuesta para leer el ID de la transacción y pasarlo a la URL
                var resultado = await response.Content.ReadFromJsonAsync<RespuestaPagoBrickDto>();
                string idPago = resultado?.IdPago ?? "desconocido";

                // 🔥 Redirigimos a la pantalla genérica de resultados, OJO: NO VACIAR EL CARRITO AQUÍ.
                Nav.NavigateTo($"/resultado-pago?status=approved&payment_id={idPago}"); 
                return true; 
            }
            else
            {
                var errorBackend = await response.Content.ReadAsStringAsync();
                
                Snackbar.Add($"Error al pagar: {errorBackend}", Severity.Error, config => 
                { 
                    config.VisibleStateDuration = 10000; 
                    config.ShowCloseIcon = true;
                });
                return false; 
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fallo de conexión: {ex.Message}", Severity.Error, config => 
            { 
                config.VisibleStateDuration = 10000; 
            });
            return false; 
        }
        finally
        {
            _procesandoPago = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }
}