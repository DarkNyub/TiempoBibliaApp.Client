@page "/carrito"
@using TiempoBiblia.Client.Models
@using Microsoft.Extensions.Configuration
@inject TiempoBiblia.Client.Services.CarritoService CarritoService
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Medium" Class="pt-8 pb-16">
    <div class="d-flex align-center mb-6">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                       Color="Color.Default" 
                       OnClick="@(() => Nav.NavigateTo("/"))" 
                       Class="mr-2" />
        <MudText Typo="Typo.h4" Style="font-weight: bold; color: #5D4037;" Class="mb-0">
            Tu Carrito de Compras 🛒
        </MudText>
    </div>

    @if (!CarritoService.Items.Any())
    {
        <MudPaper Elevation="2" Class="pa-8 text-center" Style="border-radius: 20px;">
            <MudIcon Icon="@Icons.Material.Filled.RemoveShoppingCart" Size="Size.Large" Color="Color.Default" Class="mb-4" />
            <MudText Typo="Typo.h6">Tu carrito está vacío</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="border-radius: 20px;" OnClick="@(() => Nav.NavigateTo("/"))" Class="mt-4">
                Volver a la tienda
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            <!-- LISTA DE PRODUCTOS -->
            <MudItem xs="12" md="7">
                @foreach (var item in CarritoService.Items)
                {
                    <MudPaper Elevation="1" Class="pa-4 mb-4 d-flex align-center" Style="border-radius: 12px;">
                        <div style="width: 80px; height: 80px; border-radius: 8px; overflow: hidden; margin-right: 16px;">
                            <img src="@(string.IsNullOrEmpty(item.Producto.ImagenUrl) ? "images/default.jpg" : item.Producto.ImagenUrl)" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: bold;">@item.Producto.Nombre</MudText>
                            <MudText Typo="Typo.body2" Style="color: #8D6E63;">$@item.Producto.Precio</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => CarritoService.EliminarDelCarrito(item.Producto.Id))" />
                    </MudPaper>
                }
                
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Size="Size.Large" 
                           Style="border-radius: 20px; font-weight: bold; border-width: 2px;" 
                           OnClick="@(() => Nav.NavigateTo("/"))">
                    Seguir Comprando
                </MudButton>
            </MudItem>

            <!-- ZONA DE PAGO DIRECTO (BRICKS) -->
            <MudItem xs="12" md="5">
                <MudPaper Elevation="2" Class="pa-6" Style="border-radius: 20px; background-color: #FCE4EC;">
                    <div class="d-flex justify-space-between mb-4">
                        <MudText Typo="Typo.h5" Style="font-weight: bold;">Total a Pagar:</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: bold; color: #E91E63;">$@CarritoService.ObtenerTotal()</MudText>
                    </div>

                    @if (_procesandoPago)
                    {
                        <div class="d-flex flex-column align-center my-4">
                            <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
                            <MudText Class="mt-2" Style="font-weight: bold;">Procesando tu pago...</MudText>
                        </div>
                    }

                    <!-- 🚀 AQUÍ SE DIBUJARÁ EL FORMULARIO DE TARJETA DE MERCADO PAGO -->
                    <div id="paymentBrick_container" style="@(_procesandoPago ? "display: none;" : "")"></div>

                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    // 🔥 Inyectamos IConfiguration para leer el appsettings.json
    [Inject] private IConfiguration Config { get; set; } = default!;

    private bool _procesandoPago = false;
    private DotNetObjectReference<Carrito>? _objRef;
    private bool _brickRendered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && CarritoService.Items.Any() && !_brickRendered)
        {
            var total = CarritoService.ObtenerTotal();
            if (total > 0)
            {
                _objRef = DotNetObjectReference.Create(this);
                
                // 🌟 MAGIA: Leemos la llave pública desde appsettings.json sin hardcodear nada
                string? publicKey = Config["MercadoPago:PublicKey"]; 
                
                if (string.IsNullOrEmpty(publicKey))
                {
                    Console.WriteLine("Error: No se encontró la PublicKey de Mercado Pago en appsettings.json");
                    return;
                }
                
                // Le decimos a JS que pinte el Brick
                await JS.InvokeVoidAsync("renderMercadoPagoBrick", publicKey, total, _objRef);
                _brickRendered = true;
                StateHasChanged();
            }
        }
    }

    [JSInvokable] 
    public async Task ProcesarPago(object formDataBricks) 
    {
        try
        {
            _procesandoPago = true;
            StateHasChanged(); 

            // Mandamos los datos al backend
            var response = await Http.PostAsJsonAsync("api/checkout/procesar-pago-brick", formDataBricks);
            
            if (response.IsSuccessStatusCode)
            {
                CarritoService.VaciarCarrito();
                Nav.NavigateTo("/descarga-gratuita-exitosa"); 
            }
            else
            {
                // Leer el error del backend para saber qué pasó
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error al procesar el pago: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error crítico: {ex.Message}");
        }
        finally
        {
            _procesandoPago = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }
}