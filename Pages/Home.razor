@page "/"
@using TiempoBiblia.Client.Models
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true" Color="Color.Primary">
        Explora la Biblioteca
    </MudText>

    @if (categorias == null || productos == null)
    {
        <!-- Spinner de carga elegante -->
        <MudStack AlignItems="AlignItems.Center" Class="mt-10">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText>Cargando catálogo...</MudText>
        </MudStack>
    }
    else
    {
        <!-- 1. FILTRO DE CATEGORÍAS (Píldoras) -->
        <MudStack AlignItems="AlignItems.Center" Class="mb-8">
            <MudChipSet T="int" Value="@categoriaSeleccionada" ValueChanged="FiltrarPorCategoria">
                <MudChip T="int" Value="0" Color="Color.Primary" Variant="@(categoriaSeleccionada == 0 ? Variant.Filled : Variant.Outlined)">
                    Todas
                </MudChip>
                @foreach (var cat in categorias)
                {
                    <MudChip T="int" Value="@cat.Id" Color="Color.Secondary" Variant="@(categoriaSeleccionada == cat.Id ? Variant.Filled : Variant.Outlined)">
                        @cat.Nombre
                    </MudChip>
                }
            </MudChipSet>
        </MudStack>

        <!-- 2. GRID DE PRODUCTOS -->
        <MudGrid>
            @foreach (var prod in productosVisibles)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="4" Class="h-100 d-flex flex-column">
                        <MudCardMedia Image="@(string.IsNullOrEmpty(prod.ImagenUrl) ? "https://dummyimage.com/600x400/e0e0e0/000000.png&text=Portada" : prod.ImagenUrl)" Height="200" />
                        
                        <MudCardContent Class="flex-grow-1">
                            <MudText Typo="Typo.h6">@prod.Nombre</MudText>
                            <MudText Typo="Typo.body2" Class="mb-3">@prod.Descripcion</MudText>
                            
                            <!-- Tags del producto -->
                            <div class="mb-3">
                                @foreach (var pt in prod.ProductoTags)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">#@pt.Tag.Nombre</MudChip>
                                }
                            </div>

                            <!-- Precio o Etiqueta Gratis -->
                            @if(prod.EsGratuito)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">¡Gratis!</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.h6" Color="Color.Primary"><b>$@prod.Precio</b></MudText>
                            }
                        </MudCardContent>
                        
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary">Ver Detalle</MudButton>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart" Color="Color.Default" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<CategoriaDto>? categorias;
    private List<ProductoDto>? productos;
    private List<ProductoDto> productosVisibles = new();
    
    private int categoriaSeleccionada = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Ajusta las rutas según tus Controladores de la API (asumiendo api/Categorias y api/Productos)
            categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>("api/Categorias");
            productos = await Http.GetFromJsonAsync<List<ProductoDto>>("api/Productos");

            if (productos != null)
            {
                productosVisibles = productos;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar catálogo: {ex.Message}");
        }
    }

    private void FiltrarPorCategoria(int idCategoria)
    {
        categoriaSeleccionada = idCategoria;

        if (productos != null)
        {
            if (idCategoria == 0)
            {
                productosVisibles = productos; // Mostrar todo
            }
            else
            {
                // 🔥 LA MAGIA: Buscamos si el idCategoria coincide con la principal O con alguna de las secundarias
                productosVisibles = productos.Where(p => 
                    p.CategoriaId == idCategoria || 
                    p.CategoriasSecundarias.Any(cs => cs.CategoriaId == idCategoria)
                ).ToList();
            }
        }
    }
}