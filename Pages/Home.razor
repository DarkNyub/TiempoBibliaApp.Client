@page "/"
@using TiempoBiblia.Client.Models
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    @if (categorias == null || productos == null)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-10">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText>Cargando catálogo...</MudText>
        </MudStack>
    }
    else
    {
        <!-- 1. HERO BANNER (Producto Destacado) -->
        @if (productoDestacado != null)
        {
            var heroImage = string.IsNullOrEmpty(productoDestacado.ImagenUrl) 
                ? "https://images.unsplash.com/photo-1504052434569-70ad5836ab65?q=80&w=2000&auto=format&fit=crop" 
                : productoDestacado.ImagenUrl;

            <div class="hero-container" style="background-image: url('@heroImage');">
                <div class="hero-overlay"></div>
                <div class="hero-content">
                    <MudText Typo="Typo.h2" Style="color: white; font-weight: bold; text-shadow: 2px 2px 4px rgba(0,0,0,0.8);">
                        @productoDestacado.Nombre
                    </MudText>
                    <MudText Typo="Typo.body1" Class="mt-2 mb-4" Style="color: #e0e0e0; font-size: 1.2rem; text-shadow: 1px 1px 3px rgba(0,0,0,0.8);">
                        @productoDestacado.Descripcion
                    </MudText>
                    
                    <MudStack Row="true" Spacing="4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.ShoppingCart">
                            Adquirir $@productoDestacado.Precio
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Style="color: white; border-color: white; background-color: rgba(255,255,255,0.2);" Size="Size.Large" StartIcon="@Icons.Material.Filled.Info">
                            Más Info
                        </MudButton>
                    </MudStack>
                </div>
            </div>
        }

        <!-- 2. FILAS DE CATEGORÍAS (Netflix Rows) -->
        @foreach (var fila in productosPorCategoria)
        {
            <div class="netflix-row-container">
                <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight: bold;">@fila.Key</MudText>
                
                <div class="netflix-row">
                    @foreach (var prod in fila.Value)
                    {
                        var poster = string.IsNullOrEmpty(prod.ImagenUrl) ? $"https://dummyimage.com/400x600/292929/ffffff.png&text={prod.Nombre}" : prod.ImagenUrl;
                        
                        <div class="netflix-card-wrapper">
                            <MudPaper Elevation="4" Class="card-image-container">
                                <img src="@poster" alt="@prod.Nombre" class="card-image" />
                            </MudPaper>
                            <MudText Typo="Typo.subtitle2" Class="mt-2" Style="font-weight: bold;" Align="Align.Center">
                                @prod.Nombre
                            </MudText>
                            @if(prod.EsGratuito)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success" Align="Align.Center" Style="display: block;">Gratis</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Primary" Align="Align.Center" Style="display: block;">$@prod.Precio</MudText>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }

</MudContainer>

@code {
    private List<CategoriaDto>? categorias;
    private List<ProductoDto>? productos;
    
    // El producto que saldrá en grande arriba
    private ProductoDto? productoDestacado;
    
    // Un diccionario para agrupar las filas: "Nombre de Categoría" -> Lista de Productos
    private Dictionary<string, List<ProductoDto>> productosPorCategoria = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>("api/Categorias");
            productos = await Http.GetFromJsonAsync<List<ProductoDto>>("api/Productos");

            if (productos != null && productos.Any() && categorias != null)
            {
                // Tomamos el primer producto (o el más reciente) como Destacado
                productoDestacado = productos.FirstOrDefault();

                // Armamos las filas de Netflix
                ArmarFilasCategorias();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar catálogo: {ex.Message}");
        }
    }

    private void ArmarFilasCategorias()
    {
        productosPorCategoria.Clear();

        foreach (var cat in categorias!)
        {
            // Buscamos productos donde esta categoría sea la principal O una de sus secundarias
            var productosEnEstaCategoria = productos!.Where(p => 
                p.CategoriaId == cat.Id || 
                p.CategoriasSecundarias.Any(cs => cs.CategoriaId == cat.Id)
            ).ToList();

            // Solo creamos la fila si la categoría tiene al menos un producto
            if (productosEnEstaCategoria.Any())
            {
                productosPorCategoria.Add(cat.Nombre, productosEnEstaCategoria);
            }
        }
    }
}