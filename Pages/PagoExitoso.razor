@page "/pago-exitoso"
@inject TiempoBiblia.Client.Services.CarritoService CarritoService
@inject NavigationManager Nav
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="pt-16 pb-16">
    <MudPaper Elevation="4" Class="pa-8 d-flex flex-column align-center text-center" Style="border-radius: 20px;">
        
        <!-- Icono de Éxito -->
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size: 6rem;" Class="mb-4" />
        
        <MudText Typo="Typo.h4" Style="font-weight: bold; color: #5D4037;" Class="mb-2">
            ¡Pago Aprobado! 🎉
        </MudText>
        
        <MudText Typo="Typo.body1" Class="mb-6" Style="color: #8D6E63;">
            Tu compra se procesó correctamente. Por favor, indícanos a qué correo electrónico debemos enviar los enlaces de descarga de tus recursos.
        </MudText>

        <!-- Formulario para pedir el correo -->
        <div style="width: 100%; max-width: 400px;">
            <MudTextField @bind-Value="_correoCliente" 
                          Label="Tu correo electrónico" 
                          Variant="Variant.Outlined" 
                          InputType="InputType.Email"
                          Required="true"
                          Class="mb-4" />

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       FullWidth="true" 
                       Size="Size.Large"
                       Style="border-radius: 20px; font-weight: bold;"
                       OnClick="ReclamarRecursos" 
                       Disabled="_procesando">
                @if (_procesando)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                    <MudText>Enviando...</MudText>
                }
                else
                {
                    <MudText>Enviar mis recursos</MudText>
                }
            </MudButton>
        </div>

    </MudPaper>
</MudContainer>

@code {
    private string _correoCliente = string.Empty;
    private bool _procesando = false;

    // Aquí capturamos el ID de pago que Mercado Pago manda por la URL
    [SupplyParameterFromQuery(Name = "payment_id")]
    public string? PaymentId { get; set; }

    protected override void OnInitialized()
    {
        // Si llegaron aquí pero el carrito está vacío (quizás recargaron la página)
        // los devolvemos al inicio para evitar errores.
        if (!CarritoService.Items.Any())
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task ReclamarRecursos()
    {
        if (string.IsNullOrWhiteSpace(_correoCliente) || !_correoCliente.Contains("@"))
        {
            Snackbar.Add("Por favor ingresa un correo válido.", Severity.Warning);
            return;
        }

        try
        {
            _procesando = true;

            // 1. Armamos un paquete con el correo y los IDs de los productos que compró
            var solicitud = new
            {
                Correo = _correoCliente,
                PagoId = PaymentId ?? "pago_cero", // Por si viene de un carrito gratis
                ProductosIds = CarritoService.Items.Select(i => i.Producto.Id).ToList()
            };

            // 2. Le decimos al Backend: "Genera los tokens para estos productos y envíalos a este correo"
            // (Este endpoint lo programaremos en el siguiente paso)
            var response = await Http.PostAsJsonAsync("api/descargas/despachar-pedido", solicitud);

            if (response.IsSuccessStatusCode)
            {
                // 3. Vaciamos el carrito (borra el Local Storage para que quede en 0)
                CarritoService.VaciarCarrito();
                
                Snackbar.Add("¡Enlaces enviados! Revisa tu bandeja de entrada y la carpeta de Spam.", Severity.Success);
                
                // 4. Redirigimos a una página de agradecimiento final o al inicio
                await Task.Delay(2000); // Esperamos 2 segundos para que lea el mensaje
                Nav.NavigateTo("/");
            }
            else
            {
                Snackbar.Add("Hubo un problema al generar tus enlaces. Contáctanos por soporte.", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error de conexión. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            _procesando = false;
        }
    }
}