@page "/admin/pedidos"
@using TiempoBiblia.Client.Models
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <MudText Typo="Typo.h4" Style="font-weight: bold; color: #333;">
            Historial de Ventas 💰
        </MudText>
        
        <!-- Tarjeta de Resumen Rápido -->
        <MudPaper Elevation="2" Class="pa-3" Style="background-color: #E8F5E9; border-radius: 12px;">
            <MudText Typo="Typo.subtitle2" Style="color: #2E7D32; font-weight: bold;">Ingresos Totales (COP)</MudText>
            <MudText Typo="Typo.h5" Style="color: #1B5E20; font-weight: bold; text-align: right;">
                $@(pedidos?.Where(p => p.Moneda == "COP" && p.Estado == "approved").Sum(p => p.TotalCobrado).ToString("N0") ?? "0")
            </MudText>
        </MudPaper>
    </div>

    @if (pedidos == null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (!pedidos.Any())
    {
        <MudAlert Severity="Severity.Info">Aún no hay ventas registradas en el sistema.</MudAlert>
    }
    else
    {
        <MudTable Items="@pedidos" Filter="new Func<PedidoAdminDto,bool>(Filtrar)" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="4" Style="border-radius: 12px; overflow: hidden;">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Transacciones Recientes</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="textoBusqueda" Immediate="true" Placeholder="Buscar por correo o ID..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
            </ToolBarContent>
            
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>ID Transacción</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Pasarela</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Estado</MudTh>
            </HeaderContent>
            
            <RowTemplate>
                <MudTd DataLabel="Fecha">@context.FechaCreacion.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</MudTd>
                <MudTd DataLabel="ID Transacción">
                    <MudText Typo="Typo.caption" Style="font-family: monospace;">@context.TransaccionGatewayId</MudText>
                </MudTd>
                <MudTd DataLabel="Cliente"><strong>@context.CorreoCliente</strong> <br/> <MudText Typo="Typo.caption">@context.CantidadProductos prod(s)</MudText></MudTd>
                <MudTd DataLabel="Pasarela">
                    @if(context.Pasarela == "MercadoPago")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Mercado Pago</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">PayPal</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Total"><strong>$@context.TotalCobrado.ToString("N0") @context.Moneda</strong></MudTd>
                <MudTd DataLabel="Estado">
                    @if (context.Estado == "approved")
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Aprobado</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">@context.Estado</MudChip>
                    }
                </MudTd>
            </RowTemplate>
            
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<PedidoAdminDto>? pedidos;
    private string textoBusqueda = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            pedidos = await Http.GetFromJsonAsync<List<PedidoAdminDto>>("api/Pedidos/admin");
        }
        catch
        {
            pedidos = new List<PedidoAdminDto>();
        }
    }

    private bool Filtrar(PedidoAdminDto ped) => 
        string.IsNullOrWhiteSpace(textoBusqueda) || 
        (ped.CorreoCliente?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
        ped.TransaccionGatewayId.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase);
}