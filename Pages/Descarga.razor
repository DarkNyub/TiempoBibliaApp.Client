@page "/descargar/{TokenId:guid}"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="descarga-container">
    <MudPaper Elevation="6" Class="descarga-card">
        <div class="icono-flotante">
            <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Large" Color="Color.Primary" />
        </div>
        
        <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: bold; color: #333;" Class="mt-6">
            ¡Tu material está listo!
        </MudText>

        @if (!string.IsNullOrEmpty(NombreProducto))
        {
            <MudText Typo="Typo.h6" Align="Align.Center" Style="color: #E91E63; font-weight: bold;" Class="mt-2 mb-2">
                Vas a descargar: <strong>@NombreProducto</strong>
            </MudText>
        }

        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6 mt-2" Style="color: #666;">
            Haz clic en el botón de abajo para iniciar la descarga segura. Recuerda que este enlace es personal y de <strong>UN SOLO USO</strong>.
        </MudText>

        <!-- Cambiamos Href por OnClick para procesar la descarga en silencio -->
        <MudButton Variant="Variant.Filled" 
                   Size="Size.Large" 
                   FullWidth="true" 
                   OnClick="IniciarDescargaSegura"
                   Disabled="_descargando"
                   Style="background: linear-gradient(45deg, #FFB6C1, #A8E6CF); color: #333; font-weight: bold; height: 60px; font-size: 1.2rem; border-radius: 30px;">
            @if (_descargando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Descargando archivo...</MudText>
            }
            else
            {
                <MudText>Descargar Archivo Ahora</MudText>
            }
        </MudButton>

        @if (!string.IsNullOrEmpty(_mensajeError))
        {
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Error" Class="mt-3">
                @_mensajeError
            </MudText>
        }
        
        <MudText Typo="Typo.caption" Align="Align.Center" Class="d-block mt-6" Style="color: #999;">
            Tiempo Biblia &copy; @DateTime.Now.Year. Todos los derechos reservados.
        </MudText>
    </MudPaper>
</div>

<style>
    .descarga-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #FFF0F5 0%, #E0F7FA 100%);
        padding: 1rem;
        margin-top: -20px; 
    }
    .descarga-card {
        max-width: 500px;
        width: 100%;
        padding: 3rem 1rem 1.5rem 1rem;
        border-radius: 20px;
        position: relative;
        background-color: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
    }
    .icono-flotante {
        position: absolute;
        top: -30px;
        left: 50%;
        transform: translateX(-50%);
        background: white;
        border-radius: 50%;
        padding: 1rem;
        box-shadow: 0 10px 20px rgba(168, 230, 207, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    [Parameter]
    public Guid TokenId { get; set; }

    [SupplyParameterFromQuery(Name = "nombre")]
    public string? NombreProducto { get; set; }

    private bool _descargando = false;
    private string? _mensajeError;

    private async Task IniciarDescargaSegura()
    {
        try
        {
            _descargando = true;
            _mensajeError = null;

            // -------------------------------------------------------------
            // PASO 1: AJAX de validación (Consultar si el link está activo)
            // -------------------------------------------------------------
            var validacionResponse = await Http.GetAsync($"api/descargas/validar/{TokenId}");
            
            if (!validacionResponse.IsSuccessStatusCode)
            {
                _mensajeError = "Este enlace ya fue utilizado o ha expirado.";
                return;
            }

            // -------------------------------------------------------------
            // PASO 2: AJAX de descarga (Obtener el archivo desde Drive/API)
            // -------------------------------------------------------------
            var archivoResponse = await Http.GetAsync($"api/descargas/obtener-archivo/{TokenId}");
            
            if (!archivoResponse.IsSuccessStatusCode)
            {
                _mensajeError = "No se pudo recuperar el archivo desde el servidor.";
                return;
            }

            // Leemos los bytes del archivo que envió la API
            var bytes = await archivoResponse.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);
            var nombreFinal = string.IsNullOrEmpty(NombreProducto) ? "Material_TiempoBiblia.pdf" : $"{NombreProducto}.pdf";

            // -------------------------------------------------------------
            // PASO 3: AJAX de actualización (Marcar el link como consumido)
            // -------------------------------------------------------------
            // Se envía la orden a la API para invalidar el token en la base de datos
            await Http.PostAsync($"api/descargas/marcar-usado/{TokenId}", null);

            // -------------------------------------------------------------
            // ENTREGAR EL ARCHIVO AL NAVEGADOR
            // -------------------------------------------------------------
            await JS.InvokeVoidAsync("descargarBlobSeguro", base64, nombreFinal, "application/pdf");
        }
        catch (Exception ex)
        {
            _mensajeError = "Ocurrió un error inesperado durante la descarga.";
            Console.WriteLine($"Error en flujo: {ex.Message}");
        }
        finally
        {
            _descargando = false;
        }
    }
}