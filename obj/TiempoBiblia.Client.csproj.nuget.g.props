<?xml version="1.0" encoding="utf-8" standalone="no"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <RestoreSuccess Condition=" '$(RestoreSuccess)' == '' ">True</RestoreSuccess>
    <RestoreTool Condition=" '$(RestoreTool)' == '' ">NuGet</RestoreTool>
    <ProjectAssetsFile Condition=" '$(ProjectAssetsFile)' == '' ">$(MSBuildThisFileDirectory)project.assets.json</ProjectAssetsFile>
    <NuGetPackageRoot Condition=" '$(NuGetPackageRoot)' == '' ">/home/pc/.nuget/packages/</NuGetPackageRoot>
    <NuGetPackageFolders Condition=" '$(NuGetPackageFolders)' == '' ">/home/pc/.nuget/packages/</NuGetPackageFolders>
    <NuGetProjectStyle Condition=" '$(NuGetProjectStyle)' == '' ">PackageReference</NuGetProjectStyle>
    <NuGetToolVersion Condition=" '$(NuGetToolVersion)' == '' ">7.0.0</NuGetToolVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <SourceRoot Include="/home/pc/.nuget/packages/" />
  </ItemGroup>
  <ItemGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <Content Include="$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/blob-helper.d.ts" Condition="Exists('$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/blob-helper.d.ts')">
      <NuGetPackageId>Cropper.Blazor</NuGetPackageId>
      <NuGetPackageVersion>1.5.1</NuGetPackageVersion>
      <NuGetItemType>Content</NuGetItemType>
      <Pack>false</Pack>
      <Private>False</Private>
      <Link>wwwroot/blob-helper.d.ts</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/cropper-url-image-helper.d.ts" Condition="Exists('$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/cropper-url-image-helper.d.ts')">
      <NuGetPackageId>Cropper.Blazor</NuGetPackageId>
      <NuGetPackageVersion>1.5.1</NuGetPackageVersion>
      <NuGetItemType>Content</NuGetItemType>
      <Pack>false</Pack>
      <Private>False</Private>
      <Link>wwwroot/cropper-url-image-helper.d.ts</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/cropper.min.js" Condition="Exists('$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/cropper.min.js')">
      <NuGetPackageId>Cropper.Blazor</NuGetPackageId>
      <NuGetPackageVersion>1.5.1</NuGetPackageVersion>
      <NuGetItemType>Content</NuGetItemType>
      <Pack>false</Pack>
      <Private>False</Private>
      <Link>wwwroot/cropper.min.js</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/cropperJsInterop.d.ts" Condition="Exists('$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/cropperJsInterop.d.ts')">
      <NuGetPackageId>Cropper.Blazor</NuGetPackageId>
      <NuGetPackageVersion>1.5.1</NuGetPackageVersion>
      <NuGetItemType>Content</NuGetItemType>
      <Pack>false</Pack>
      <Private>False</Private>
      <Link>wwwroot/cropperJsInterop.d.ts</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/cropperJsInterop.min.js" Condition="Exists('$(NuGetPackageRoot)cropper.blazor/1.5.1/contentFiles/any/net10.0/wwwroot/cropperJsInterop.min.js')">
      <NuGetPackageId>Cropper.Blazor</NuGetPackageId>
      <NuGetPackageVersion>1.5.1</NuGetPackageVersion>
      <NuGetItemType>Content</NuGetItemType>
      <Pack>false</Pack>
      <Private>False</Private>
      <Link>wwwroot/cropperJsInterop.min.js</Link>
    </Content>
  </ItemGroup>
  <ImportGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <Import Project="$(NuGetPackageRoot)mudblazor/9.7.0/buildTransitive/MudBlazor.props" Condition="Exists('$(NuGetPackageRoot)mudblazor/9.7.0/buildTransitive/MudBlazor.props')" />
    <Import Project="$(NuGetPackageRoot)microsoft.net.sdk.webassembly.pack/10.0.10/build/Microsoft.NET.Sdk.WebAssembly.Pack.props" Condition="Exists('$(NuGetPackageRoot)microsoft.net.sdk.webassembly.pack/10.0.10/build/Microsoft.NET.Sdk.WebAssembly.Pack.props')" />
    <Import Project="$(NuGetPackageRoot)microsoft.net.illink.tasks/10.0.10/build/Microsoft.NET.ILLink.Tasks.props" Condition="Exists('$(NuGetPackageRoot)microsoft.net.illink.tasks/10.0.10/build/Microsoft.NET.ILLink.Tasks.props')" />
    <Import Project="$(NuGetPackageRoot)microsoft.dotnet.hotreload.webassembly.browser/10.0.110/buildTransitive/Microsoft.DotNet.HotReload.WebAssembly.Browser.props" Condition="Exists('$(NuGetPackageRoot)microsoft.dotnet.hotreload.webassembly.browser/10.0.110/buildTransitive/Microsoft.DotNet.HotReload.WebAssembly.Browser.props')" />
    <Import Project="$(NuGetPackageRoot)microsoft.aspnetcore.components.webassembly/10.0.9/build/net10.0/Microsoft.AspNetCore.Components.WebAssembly.props" Condition="Exists('$(NuGetPackageRoot)microsoft.aspnetcore.components.webassembly/10.0.9/build/net10.0/Microsoft.AspNetCore.Components.WebAssembly.props')" />
    <Import Project="$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets/10.0.10/build/Microsoft.AspNetCore.App.Internal.Assets.props" Condition="Exists('$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets/10.0.10/build/Microsoft.AspNetCore.App.Internal.Assets.props')" />
    <Import Project="$(NuGetPackageRoot)cropper.blazor/1.5.1/buildTransitive/Cropper.Blazor.props" Condition="Exists('$(NuGetPackageRoot)cropper.blazor/1.5.1/buildTransitive/Cropper.Blazor.props')" />
  </ImportGroup>
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <PkgMicrosoft_NET_Sdk_WebAssembly_Pack Condition=" '$(PkgMicrosoft_NET_Sdk_WebAssembly_Pack)' == '' ">/home/pc/.nuget/packages/microsoft.net.sdk.webassembly.pack/10.0.10</PkgMicrosoft_NET_Sdk_WebAssembly_Pack>
    <PkgMicrosoft_NET_ILLink_Tasks Condition=" '$(PkgMicrosoft_NET_ILLink_Tasks)' == '' ">/home/pc/.nuget/packages/microsoft.net.illink.tasks/10.0.10</PkgMicrosoft_NET_ILLink_Tasks>
    <PkgMicrosoft_AspNetCore_Components_WebAssembly_DevServer Condition=" '$(PkgMicrosoft_AspNetCore_Components_WebAssembly_DevServer)' == '' ">/home/pc/.nuget/packages/microsoft.aspnetcore.components.webassembly.devserver/10.0.9</PkgMicrosoft_AspNetCore_Components_WebAssembly_DevServer>
  </PropertyGroup>
</Project>