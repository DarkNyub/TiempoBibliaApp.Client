@inherits LayoutComponentBase
@inject TiempoBiblia.Client.Services.CarritoService Carrito
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider Theme="@MiTemaPastel" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <!-- Quitamos el MudAppBar para dejar la pantalla 100% libre -->

    <MudMainContent>
        @Body
        
        <!-- 🔥 BOTÓN FLOTANTE DEL CARRITO (Siempre visible, excepto en /carrito) -->
        @if (!EsPaginaCarrito)
        {
            <div class="carrito-flotante-container">
                <MudBadge Content="Carrito.ObtenerCantidadItems()" Color="Color.Secondary" Overlap="true" Visible="@(Carrito.ObtenerCantidadItems() > 0)">
                    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShoppingCart" 
                            Size="Size.Large" OnClick="@(() => Nav.NavigateTo("/carrito"))" 
                            Class="btn-carrito-flotante" />
                </MudBadge>
            </div>
        }
    </MudMainContent>
</MudLayout>

<style>
</style>

@code {
    // Detectamos si estamos en la página del carrito
    private bool EsPaginaCarrito => Nav.Uri.Contains("/carrito", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        // 1. Apenas se carga la página, recuperamos el carrito del Local Storage
        Carrito.CargarCarritoGuardado();

        // 2. Le decimos al layout que se actualice cada vez que el carrito cambie
        Carrito.OnCarritoCambiado += StateHasChanged;
        
        // 3. Le decimos al layout que se actualice si cambiamos de página (para ocultar/mostrar el carrito)
        Nav.LocationChanged += ActualizarVista;
    }

    private void ActualizarVista(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        // Buena práctica: desconectar los eventos
        Carrito.OnCarritoCambiado -= StateHasChanged;
        Nav.LocationChanged -= ActualizarVista;
    }
    
    // Aquí definimos tu identidad visual a nivel global
    MudTheme MiTemaPastel = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#F48FB1", // Rosa pastel suave
            Secondary = "#80CBC4", // Aguamarina contrastante
            AppbarBackground = "#F48FB1", // La barra de arriba en rosa (ya no se usa, pero la dejamos por si acaso)
            Background = "#FFF8F9", // Un fondo blanco con una gotita imperceptible de rosa
            Surface = "#FFFFFF", // Las tarjetas 100% blancas para que destaquen
            TextPrimary = "#5D4037", // Texto marrón suave
            TextSecondary = "#8D6E63", 
            ActionDefault = "#F48FB1" // Los iconos por defecto en rosa
        }
    };
}